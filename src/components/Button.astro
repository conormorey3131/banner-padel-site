---
interface Props {
  href: string;
  variant?: "primary" | "outline" | "light";
  external?: boolean;
  class?: string;
}
const { href, variant = "primary", external = false, class: klass = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 font-display " +
  "text-sm font-semibold tracking-tight transition-all duration-200 " +
  "hover:-translate-y-0.5 active:translate-y-0";

const variants = {
  primary: "bg-saffron text-navy hover:bg-saffron-600 shadow-[0_4px_20px_-6px_rgba(255,213,2,0.7)]",
  outline: "border border-navy/20 text-navy hover:border-navy/50 hover:bg-navy/[0.03]",
  light: "border border-white/25 text-white hover:border-white/60 hover:bg-white/10",
};

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a href={href} rel={rel} target={target} class={`${base} ${variants[variant]} ${klass}`}>
  <slot />
</a>
