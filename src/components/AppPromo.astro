---
// Loyalty app promo. Store badges everywhere; QR codes only where a phone
// camera is likely pointed at the screen (desktop and up).
import { Image } from "astro:assets";
import { site } from "../data/site";
import icon from "../assets/banner-padel-app-icon.png";
import qrAppStore from "../assets/qr-app-store.svg";
import qrGooglePlay from "../assets/qr-google-play.svg";

const perks = [
  "Points every time you check in",
  "Rewards you can spend at the club",
  "Bonus points for socials and surveys",
];

const badge =
  "inline-flex items-center gap-3 rounded-xl bg-black px-4 py-2.5 text-white ring-1 ring-white/15 " +
  "transition-all duration-200 hover:-translate-y-0.5 hover:ring-white/40";
---

<section id="app" class="bg-navy px-6 py-20 text-bone md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
    <div class="reveal">
      <p class="eyebrow mb-5 text-saffron">The Banner Padel app</p>
      <h2 class="text-4xl font-bold tracking-tight md:text-5xl">
        Play more, earn more.
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone/70">
        Join the club on your phone. Earn points every time you visit and swap them for
        rewards at the desk. Free to download, takes a minute to set up.
      </p>

      <ul class="mt-8 space-y-3">
        {
          perks.map((perk) => (
            <li class="flex items-start gap-3 text-bone/85">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-saffron" aria-hidden="true">
                <path d="M4 10.5l4 4 8-9" />
              </svg>
              <span>{perk}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href={site.app.appStore} target="_blank" rel="noopener" class={badge} aria-label="Download the Banner Padel app on the App Store">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
            <path d="M16.5 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.2 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.9-4zM14 5.2c.7-.8 1.2-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3.1 1.1.1 2.2-.6 2.9-1.4z" />
          </svg>
          <span class="leading-none">
            <span class="block text-[0.65rem] tracking-wide text-white/75">Download on the</span>
            <span class="mt-0.5 block font-display text-base font-semibold">App Store</span>
          </span>
        </a>

        <a href={site.app.googlePlay} target="_blank" rel="noopener" class={badge} aria-label="Get the Banner Padel app on Google Play">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path fill="#00D7FE" d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L3.7 2.2l-.1.1z" />
            <path fill="#FFCE00" d="M16.1 15.6l-3.1-3.1v-.2l3.1-3.1.1.1 3.7 2.1c1 .6 1 1.6 0 2.2l-3.7 2.1-.1-.1z" />
            <path fill="#FF3A44" d="M16.2 15.5L13 12.3 3.6 21.7c.3.4.9.4 1.5.1l11.1-6.3" />
            <path fill="#00F076" d="M16.2 9.1L5.1 2.8c-.6-.4-1.2-.3-1.5.1L13 12.3l3.2-3.2z" />
          </svg>
          <span class="leading-none">
            <span class="block text-[0.65rem] tracking-wide text-white/75">Get it on</span>
            <span class="mt-0.5 block font-display text-base font-semibold">Google Play</span>
          </span>
        </a>
      </div>
    </div>

    <!-- Icon on mobile; icon plus scannable codes on desktop -->
    <div class="reveal">
      <div class="rounded-2xl border border-white/10 bg-navy-700 p-6 md:p-8">
        <div class="flex items-center gap-5">
          <Image
            src={icon}
            alt=""
            width={144}
            height={144}
            class="h-16 w-16 shrink-0 rounded-2xl ring-1 ring-white/15 md:h-[72px] md:w-[72px]"
            loading="lazy"
          />
          <div>
            <p class="font-display text-xl font-bold tracking-tight">Banner Padel App</p>
            <p class="mt-1 text-sm text-bone/60">Free on iOS and Android</p>
          </div>
        </div>

        <div class="mt-8 hidden gap-6 lg:grid lg:grid-cols-2">
          <a href={site.app.appStore} target="_blank" rel="noopener" class="group block rounded-xl bg-white p-4 transition-transform hover:-translate-y-0.5">
            <Image src={qrAppStore} alt="QR code linking to the Banner Padel app on the App Store" width={220} height={220} class="h-auto w-full" loading="lazy" />
            <p class="mt-3 text-center font-display text-xs font-semibold tracking-wide text-navy">Scan for iPhone</p>
          </a>
          <a href={site.app.googlePlay} target="_blank" rel="noopener" class="group block rounded-xl bg-white p-4 transition-transform hover:-translate-y-0.5">
            <Image src={qrGooglePlay} alt="QR code linking to the Banner Padel app on Google Play" width={220} height={220} class="h-auto w-full" loading="lazy" />
            <p class="mt-3 text-center font-display text-xs font-semibold tracking-wide text-navy">Scan for Android</p>
          </a>
        </div>
        <p class="mt-5 hidden text-center text-xs text-bone/45 lg:block">
          Point your phone camera at a code to open the store.
        </p>
      </div>
    </div>
  </div>
</section>
