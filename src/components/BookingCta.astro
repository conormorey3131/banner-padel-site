---
import { site } from "../data/site";
import Button from "./Button.astro";
interface Props {
  title?: string;
  body?: string;
}
const {
  title = "Grab a court.",
  body = "Six full Super Panoramic indoor courts, ready for all weather. Rackets are available to hire and balls are available to buy at reception.",
} = Astro.props;
---

<section class="bg-navy px-6 py-24 text-bone">
  <div class="reveal mx-auto max-w-3xl text-center">
    <p class="eyebrow mb-5 text-saffron">Ready to play</p>
    <h2 class="text-4xl font-bold tracking-tight md:text-6xl">
      {title}
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-bone/70">{body}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href={site.booking}>Book a court</Button>
      <Button href="/contact/" variant="light">Book a lesson</Button>
    </div>
  </div>
</section>
