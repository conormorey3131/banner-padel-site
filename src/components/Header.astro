---
import { Image } from "astro:assets";
import logo from "../assets/banner-padel-logo-wordmark.png";
import { site, nav } from "../data/site";
import Button from "./Button.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, "");
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line/70 bg-bone/85 backdrop-blur-md transition-shadow duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${site.name} — home`}>
      <Image src={logo} alt={site.name} width={165} height={65} densities={[1, 2]} quality={100} class="h-auto w-[140px] rounded-md bg-navy sm:w-[165px]" loading="eager" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-5 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "font-display text-sm font-medium tracking-tight transition-colors",
              isCurrent(item.href) ? "text-navy" : "text-muted hover:text-navy",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block"><Button href={site.booking} class="px-6 py-3">Book a court</Button></div>
      <button
        type="button"
        id="menu-toggle"
        class="grid h-11 w-11 place-items-center rounded-full border border-navy/15 text-navy lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-bone lg:hidden">
    <nav aria-label="Mobile" class="mx-auto flex max-w-6xl flex-col px-6 py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-line/70 py-4 font-display text-lg font-semibold tracking-tight text-navy last:border-0"
          >
            {item.label}
          </a>
        ))
      }
      <Button href={site.booking} class="my-4">Book a court</Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (menu) menu.hidden = open;
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
    });
  });

  // Lift the header off the page once the user scrolls.
  const header = document.getElementById("site-header");
  const onScroll = () => {
    header?.classList.toggle("shadow-[0_1px_24px_-8px_rgba(6,22,51,0.25)]", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
