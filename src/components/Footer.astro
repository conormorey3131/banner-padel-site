---
import { Image } from "astro:assets";
import wordmark from "../assets/banner-padel-logo-wordmark.png";
import { site, nav } from "../data/site";
import Social from "./Social.astro";
import Button from "./Button.astro";

const year = new Date().getFullYear();
---

<footer class="bg-navy px-6 pt-20 pb-10 text-bone">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-14 border-b border-white/10 pb-14 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <Image src={wordmark} alt={site.name} width={220} height={87} class="h-auto w-[200px]" loading="lazy" />
        <p class="mt-6 max-w-xs leading-relaxed text-bone/60">
          {site.tagline} — six full panoramic indoor courts in {site.town}, {site.county}.
        </p>
        <div class="mt-7">
          <Button href="/book/">Book a court</Button>
        </div>
      </div>

      <div>
        <h2 class="eyebrow mb-5 text-saffron">Explore</h2>
        <ul class="space-y-3">
          <li><a href="/book/" class="text-bone/70 transition-colors hover:text-saffron">Book a court</a></li>
          {nav.map((item) => (
            <li><a href={item.href} class="text-bone/70 transition-colors hover:text-saffron">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="eyebrow mb-5 text-saffron">Visit</h2>
        <address class="not-italic leading-relaxed text-bone/70">
          {site.address.line1}<br />{site.address.region}<br />Ireland
        </address>
        {site.email && (
          <a href={`mailto:${site.email}`} class="mt-3 block text-bone/70 transition-colors hover:text-saffron">{site.email}</a>
        )}
        {site.phone && (
          <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="mt-1 block text-bone/70 transition-colors hover:text-saffron">{site.phone}</a>
        )}
        <div class="mt-6">
          <Social tone="light" showHandle={false} />
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 pt-8 text-sm text-bone/45 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        Built by{" "}
        <a href="https://moreydigital.ie" target="_blank" rel="noopener" class="text-bone/70 underline-offset-4 transition-colors hover:text-saffron hover:underline">Morey Digital</a>
      </p>
    </div>
  </div>
</footer>
