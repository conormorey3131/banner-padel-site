---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Feature from "../components/Feature.astro";
import BookingCta from "../components/BookingCta.astro";
import court from "../assets/padel-court-ennis.webp";
import gallery1 from "../assets/banner-padel-gallery-1.jpg";
import gallery2 from "../assets/banner-padel-gallery-2.jpg";
import gallery3 from "../assets/banner-padel-gallery-3.jpg";
import gallery4 from "../assets/banner-padel-gallery-4.jpg";
import gallery5 from "../assets/banner-padel-gallery-5.jpg";
import gallery6 from "../assets/banner-padel-gallery-6.jpg";
import gallery7 from "../assets/banner-padel-gallery-7.jpg";
import gallery8 from "../assets/banner-padel-gallery-8.jpg";
import gallery9 from "../assets/banner-padel-gallery-9.jpg";
import { site } from "../data/site";

const firstVisit = [
  { title: "Arrive ten minutes early", body: "Enough time to check in at the desk, pick up hire rackets and get a look at the court before your slot starts." },
  { title: "Wear clean trainers", body: "Clean sports or court shoes with good grip are recommended. Please make sure footwear is clean before entering the courts." },
  { title: "Bring a water bottle", body: "There is water on site and the café is open, but a bottle courtside saves you the walk between games." },
  { title: "No kit needed", body: "Rackets are available to hire and balls are available to buy at reception. Turn up with trainers and you are ready to play." },
];
const gallery = [
  { src: gallery1, alt: "A player smiling on court behind the net at Banner Padel" },
  { src: gallery2, alt: "Two players at the back glass during a game at Banner Padel" },
  { src: gallery3, alt: "A player mid-shot during a match at Banner Padel" },
  { src: gallery4, alt: "The Banner Padel sign seen through the court glass" },
  { src: gallery5, alt: "The walkway between the courts at Banner Padel" },
  { src: gallery6, alt: "A court at Banner Padel with the club sign on the wall behind the net" },
  { src: gallery7, alt: "Court 5 at Banner Padel with a game in progress" },
  { src: gallery8, alt: "Match play across the net at Banner Padel" },
  { src: gallery9, alt: "Looking along the line of nets between courts at Banner Padel" },
];
---

<Layout
  title="The Venue"
  description="Inside Banner Padel, Ennis — six Super Panoramic indoor courts, a café and lounge, changing facilities, racket hire and free parking in Co. Clare."
>
  <PageHero
    eyebrow="The venue"
    title="Built to be worth staying in."
    intro="Six Super Panoramic indoor courts under one roof in Ennis, with a café and lounge to relax, catch up and enjoy the club before and after you play."
  />

  <section class="border-b border-line">
    <Image
      src={court}
      alt="Inside Banner Padel — indoor Super Panoramic padel court in Ennis, Co. Clare"
      widths={[720, 1200, 1600]}
      sizes="100vw"
      class="h-[320px] w-full object-cover md:h-[520px]"
      loading="lazy"
    />
  </section>

  <Section tone="white" eyebrow="Gallery" title="Inside the club.">
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 760]}
          sizes="(min-width: 1024px) 370px, (min-width: 640px) calc(50vw - 40px), calc(100vw - 48px)"
          class="reveal aspect-[2/3] h-auto w-full rounded-2xl object-cover"
          loading="lazy"
        />
      ))}
    </div>
  </Section>

  <Section
    tone="bone"
    eyebrow="Facilities"
    title="Everything the session needs."
    intro="Everything you need for a great game, with the facilities to enjoy the club before and after you play."
  >
    <div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      <Feature
        icon="court"
        title="Six Super Panoramic Courts"
        body="Six Super Panoramic indoor courts featuring Mondo XN Supercourt turf, designed to deliver a premium playing experience all year round."
      />
      <Feature
        icon="cafe"
        title="Café & Lounge"
        body="Coffee, cold drinks and food, with comfortable seating overlooking the courts — the perfect place to relax before or after your game."
      />
      <Feature
        icon="locker"
        title="Changing Facilities"
        body="Changing rooms and showers on site, making it easy to play before work, after work or whenever suits."
      />
      <Feature
        icon="gear"
        title="Racket Hire & Balls"
        body="Rackets are available to hire and balls are available to buy at reception."
      />
      <Feature
        icon="parking"
        title="Parking On Site"
        body="Convenient on-site parking right outside the club."
      />
      <Feature
        icon="league"
        title="Events & Private Hire"
        body="Corporate days, schools, sports clubs, private groups, leagues, Americanos and tournaments — with multiple courts available for larger events."
      />
    </div>
  </Section>

  <Section tone="white" eyebrow="First visit" title="What to expect.">
    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        firstVisit.map((item) => (
          <div class="reveal bg-white p-8">
            <h3 class="font-display text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="navy" eyebrow="Opening hours" title="When we're open.">
    <div class="mt-12 grid gap-12 md:grid-cols-2">
      <dl class="reveal divide-y divide-white/10 border-y border-white/10">
        {
          site.hours.map((row) => (
            <div class="flex items-center justify-between gap-6 py-5">
              <dt class="font-display font-semibold">{row.days}</dt>
              <dd class="tabular-nums text-bone/65">{row.time}</dd>
            </div>
          ))
        }
      </dl>
      <div class="reveal">
        <p class="leading-relaxed text-bone/70">
          Live court availability is always the most accurate picture of when we are
          open — if a slot shows in the booking calendar, you can play it.
        </p>
        <p class="mt-5 leading-relaxed text-bone/70">
          Bank holidays and event days can differ. We post any changes on
          {" "}<a href={site.social.instagram} target="_blank" rel="noopener" class="text-saffron underline-offset-4 hover:underline">Instagram</a>{" "}
          first.
        </p>
      </div>
    </div>
  </Section>

  <BookingCta
    title="Come and see it."
    body="Book a court, come for a lesson, or just call in for a coffee and watch a game from the lounge."
  />
</Layout>
