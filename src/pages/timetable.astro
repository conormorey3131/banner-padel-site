---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";

// Transcribed from the weekly timetable supplied by the club.
const sessions = [
  { day: "Monday", time: "9:30–11:00am", name: "Ladies Coffee Club", level: "Mixed ability", price: 12, coffee: true },
  { day: "Tuesday", time: "9:30–11:00am", name: "Over 50s Mixed Coffee Club", level: "Mixed ability", price: 12, coffee: true },
  { day: "Tuesday", time: "7:00–9:00pm", name: "Ladies Social", level: "All levels", price: 15 },
  { day: "Wednesday", time: "7:00–9:00pm", name: "Men’s Social", level: "All levels", price: 15 },
  { day: "Thursday", time: "7:00–9:00pm", name: "Ladies Social", level: "All levels", price: 15 },
  { day: "Friday", time: "9:30–11:00am", name: "Over 50s Mixed Coffee Club", level: "Mixed ability", price: 12, coffee: true },
  { day: "Friday", time: "7:00–9:00pm", name: "Friday Night Padel & Pizza", level: "All levels", price: 18 },
  { day: "Saturday", time: "10:00am–12:00pm", name: "Ladies Americano", level: "All levels", price: 15 },
  { day: "Sunday", time: "10:00am–12:00pm", name: "Mixed Americano", level: "All levels", price: 15 },
];
---
<Layout title="Weekly Timetable" description="Coffee clubs, social padel, Friday night padel and pizza, and weekend Americanos at Banner Padel, Ennis. Sessions from €12. Book via Playtomic.">
  <PageHero eyebrow="Play · Meet · Improve · Belong" title="Your week on court." intro="A place to play. A community to belong to. Come on your own, meet new players and find your regular session." />
  <section class="bg-bone px-6 pb-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 grid gap-4 sm:grid-cols-3">
        <p class="rounded-xl bg-navy p-5 font-semibold text-bone">No partner needed</p>
        <p class="rounded-xl bg-navy p-5 font-semibold text-bone">Rackets & balls included</p>
        <p class="rounded-xl bg-navy p-5 font-semibold text-bone">Tea & coffee at all Coffee Clubs</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {sessions.map(session => (
          <article class="flex flex-col rounded-2xl border border-line bg-white p-7">
            <p class="eyebrow text-muted">{session.day}</p>
            <p class="mt-2 text-sm text-muted">{session.time}</p>
            <h2 class="mt-5 text-2xl font-bold">{session.name}</h2>
            <p class="mt-3 text-muted">{session.level}{session.coffee && " · Tea/coffee included"}</p>
            <div class="mt-auto flex items-center justify-between gap-4 pt-7">
              <p class="font-display text-3xl font-bold">€{session.price}</p>
              <a href={site.booking} target="_blank" rel="noopener" class="rounded-full bg-saffron px-5 py-3 text-sm font-semibold" aria-label={`Book ${session.name} on ${session.day} via Playtomic`}>Book on Playtomic →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-7 text-sm text-muted">All times are local to Ennis. Check Playtomic for availability and any timetable changes.</p>
      <div class="mt-12 border-t border-line pt-10">
        <h2 class="text-2xl font-bold">Looking for coaching?</h2>
        <p class="mt-3 mb-6 text-muted">Explore lessons and programmes, or get in touch about the right session for you.</p>
        <Button href="/coaching/" variant="outline">Explore coaching</Button>
      </div>
    </div>
  </section>
</Layout>
