---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Social from "../components/Social.astro";
import { site } from "../data/site";
---

<Layout
  title="Contact"
  description="Get in touch with Banner Padel in Ennis, Co. Clare — coaching enquiries, group and corporate bookings, leagues, events and general questions."
>
  <PageHero
    eyebrow="Contact"
    title="Say hello."
    intro="Coaching, group bookings, corporate days, leagues or a question before your first session — we'll come back to you."
  />

  <Section tone="bone" class="!pt-16">
    <div class="grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
      <form id="enquiry" class="reveal space-y-6" method="POST" action={`https://formsubmit.co/${site.email}`}>
        <input type="hidden" name="_subject" value="Banner Padel — website enquiry" />
        <input type="hidden" name="_next" value={`${site.url}/thank-you/`} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block font-display text-sm font-semibold">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full rounded-xl border border-line bg-white px-4 py-3.5 text-navy transition-colors placeholder:text-muted/60 focus:border-navy/40"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block font-display text-sm font-semibold">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full rounded-xl border border-line bg-white px-4 py-3.5 text-navy transition-colors placeholder:text-muted/60 focus:border-navy/40"
              placeholder="you@example.com"
            />
          </div>
        </div>

        <div>
          <label for="topic" class="mb-2 block font-display text-sm font-semibold">What's it about?</label>
          <select
            id="topic"
            name="topic"
            class="w-full rounded-xl border border-line bg-white px-4 py-3.5 text-navy transition-colors focus:border-navy/40"
          >
            <option>Coaching or lessons</option>
            <option value="groups">Group or corporate booking</option>
            <option value="membership">Membership</option>
            <option>Leagues, socials and events</option>
            <option>Junior programmes</option>
            <option>Something else</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block font-display text-sm font-semibold">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="w-full rounded-xl border border-line bg-white px-4 py-3.5 text-navy transition-colors placeholder:text-muted/60 focus:border-navy/40"
            placeholder="Tell us a bit about what you're after — level, group size, preferred days."></textarea>
        </div>

        <p class="text-sm leading-relaxed text-muted">
          We’ll use your details to respond to your enquiry. Submissions are handled by FormSubmit,
          which may ask you to complete a spam check. Read our
          <a href="/privacy/" class="underline underline-offset-4">privacy notice</a>.
          You can also email <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a> directly.
        </p>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full bg-saffron px-8 py-4 font-display text-sm font-semibold tracking-tight text-navy shadow-[0_4px_20px_-6px_rgba(255,213,2,0.7)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-saffron-600"
        >
          Send enquiry
        </button>
      </form>

      <aside class="reveal space-y-10">
        <div class="rounded-2xl border border-line bg-white p-8">
          <h2 class="font-display text-xl font-bold tracking-tight">Book a court</h2>
          <p class="mt-3 leading-relaxed text-muted">
            Court bookings are handled online, not by email — live availability is always
            in the booking calendar.
          </p>
          <div class="mt-6">
            <Button href={site.booking}>See availability</Button>
          </div>
        </div>

        <div>
          <h2 class="eyebrow mb-4 text-navy/45">Where we are</h2>
          <address class="not-italic text-lg leading-relaxed">
            {site.name}<br />
            {site.address.line1}<br />
            {site.address.locality}, {site.address.region}<br />
            {site.address.postalCode}, Ireland
          </address>
          <a href={site.directions} target="_blank" rel="noopener" class="mt-4 block font-medium underline underline-offset-4">Get directions →</a>
          {site.email && (
            <a href={`mailto:${site.email}`} class="mt-4 block font-medium text-navy underline underline-offset-4">{site.email}</a>
          )}
          {site.phone && (
            <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="mt-1 block font-medium text-navy underline underline-offset-4">{site.phone}</a>
          )}
        </div>

        <div>
          <h2 class="eyebrow mb-4 text-navy/45">Follow along</h2>
          <p class="mb-5 leading-relaxed text-muted">
            News, events and last-minute court availability go out on social first.
          </p>
          <Social />
        </div>

        <div>
          <h2 class="eyebrow mb-4 text-navy/45">Opening hours</h2>
          <dl class="divide-y divide-line border-y border-line">
            {
              site.hours.map((row) => (
                <div class="flex items-center justify-between gap-6 py-3.5">
                  <dt class="text-sm font-medium">{row.days}</dt>
                  <dd class="text-sm tabular-nums text-muted">{row.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </Section>
</Layout>

<script>
  const topic = new URLSearchParams(window.location.search).get("topic");
  const select = document.querySelector<HTMLSelectElement>("#topic");
  if (select && (topic === "membership" || topic === "groups")) select.value = topic;
</script>
