---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import BookingCta from "../components/BookingCta.astro";
import court from "../assets/padel-court-ennis.webp";
import coachPortrait from "../assets/coach-jesus-maicas.jpg";
import coachAction from "../assets/coach-jesus-action.jpg";
import { site } from "../data/site";

const programmes = [
  {
    name: "Junior Padel Academies",
    who: "Saturdays · Ages 6–11 & 12–15",
    tag: "New · Starts 21 November",
    body: "Four Saturday academies with Jesús, starting Saturday 21 November. Structured coaching in a fun, social environment, with rackets and balls included.",
    points: ["Ages 6–11: Saturdays 1–2pm", "Ages 12–15: Saturdays 2–3pm", "€10 per child per session", "Max 8 children per academy", "Beginners welcome"],
    featured: true,
    cta: "Book a place",
  },
  {
    name: "Ladies' Beginners Classes",
    who: "Tuesdays · 7–8:30pm",
    body: "A friendly introduction to padel, helping you build skills and confidence.",
    points: ["Tuesdays 7–8:30pm", "Beginners welcome", "Friendly, social group"],
    featured: false,
    cta: "Enquire",
  },
  {
    name: "Men's Beginner/Improver Classes",
    who: "Wednesdays · 7–8:30pm",
    body: "Develop your technique, improve your game and meet other players.",
    points: ["Wednesdays 7–8:30pm", "Beginners & improvers", "Technique and match play"],
    featured: false,
    cta: "Enquire",
  },
];

const singleSessions = [
  { name: "1-to-1", price: "€80", each: null },
  { name: "2-to-1", price: "€100", each: "€50 each" },
  { name: "3-to-1", price: "€120", each: "€40 each" },
  { name: "4-to-1", price: "€140", each: "€35 each" },
];

const blockSessions = [
  { name: "1-to-1", price: "€300", each: null },
  { name: "2-to-1", price: "€380", each: "€190 each" },
  { name: "3-to-1", price: "€460", each: "€153.33 each" },
  { name: "4-to-1", price: "€540", each: "€135 each" },
];

const path = [
  { step: "Never played", body: "Start on a beginner group clinic. You will serve, rally and use the back wall inside the first session." },
  { step: "Played a few times", body: "Move into the improver groups, where the focus shifts to positioning and knowing when to lob." },
  { step: "Playing weekly", body: "One-to-ones to sharpen individual shots, plus club leagues to test them under pressure." },
  { step: "Competing", body: "Tournament prep, pairs work and tactical sessions with a coach who has watched you play." },
];
---

<Layout
  title="Coaching & Lessons"
  description="Padel coaching in Ennis, Co. Clare with head coach Jesús Maicas — junior academies, ladies' and men's beginner classes, private lessons and block coaching at Banner Padel."
>
  <PageHero
    eyebrow="Coaching"
    title="Get good faster than you'd expect."
    intro="Padel is easy to start and deep to master. An hour with a coach early on saves you months of picking up habits you'll only have to unlearn."
  />

  <section class="bg-bone px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="reveal overflow-hidden rounded-2xl">
        <Image
          src={coachPortrait}
          alt="Jesús Maicas, padel coach at Banner Padel"
          widths={[480, 800]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="h-[420px] w-full object-cover object-top md:h-[560px]"
          loading="lazy"
        />
      </div>
      <div class="reveal">
        <p class="eyebrow mb-4 text-navy/45">Meet our coach</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">Jesús Maicas</h2>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          Hello everyone, my name is Jesús Maicas, I am 26 years old, and I am delighted
          to introduce myself as the new padel coach at Banner Padel.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          I have been playing padel competitively at national level since the age of 15.
          I have over six years of coaching experience in Madrid, Spain, having worked as
          a padel instructor at DN Padel Academy, one of the most prestigious and
          well-recognised padel academies in Madrid.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          I am truly excited and motivated to embark on this new chapter with Banner
          Padel. I look forward to sharing my passion for the sport, helping players
          develop their skills, and contributing to the growth of the padel community.
          I look forward to meeting you all and seeing you on the courts very soon!
        </p>
        <ul class="mt-7 space-y-2.5">
          {
            [
              "Competing at national level in Spain since the age of 15",
              "Over six years of coaching experience in Madrid",
              "Instructor at DN Padel Academy, Madrid",
            ].map((point) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 shrink-0 text-saffron-600" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 4" />
                </svg>
                <span class="text-sm text-navy/75">{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Section tone="white" eyebrow="Classes & academies" title="Pick your session.">
    <div class="mt-14 grid gap-7 lg:grid-cols-3">
      {
        programmes.map((programme) => (
          <div
            class:list={[
              "reveal flex flex-col rounded-2xl p-8 md:p-9",
              programme.featured
                ? "bg-navy text-bone ring-2 ring-saffron"
                : "border border-line bg-white",
            ]}
          >
            {programme.featured && (
              <p class="eyebrow mb-5 text-saffron">{programme.tag}</p>
            )}
            <h2 class="font-display text-2xl font-bold tracking-tight">{programme.name}</h2>
            <p
              class:list={[
                "mt-1.5 text-sm",
                programme.featured ? "text-bone/55" : "text-muted",
              ]}
            >
              {programme.who}
            </p>
            <p
              class:list={[
                "mt-6 flex-1 leading-relaxed",
                programme.featured ? "text-bone/75" : "text-muted",
              ]}
            >
              {programme.body}
            </p>
            <ul class="mt-7 space-y-2.5">
              {programme.points.map((point) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-1 shrink-0 text-saffron-600" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 8.5l3.5 3.5L13 4" />
                  </svg>
                  <span
                    class:list={[
                      "text-sm",
                      programme.featured ? "text-bone/80" : "text-navy/75",
                    ]}
                  >
                    {point}
                  </span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <Button href="/contact/" variant={programme.featured ? "light" : "outline"} class="w-full">
                {programme.cta}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
    <p class="reveal mt-8 text-sm text-muted">
      To book a junior academy place or ask about a class, message the club or use the{" "}
      <a href="/contact/" class="font-medium text-navy underline underline-offset-4 hover:text-saffron-600">
        contact page
      </a>
      .
    </p>
  </Section>

  <section class="bg-navy px-6 py-20 text-bone md:py-28">
    <div class="mx-auto max-w-6xl">
      <header class="reveal max-w-2xl">
        <p class="eyebrow mb-4 text-saffron">Private lessons</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">
          Private lessons &amp; block coaching.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-bone/70">
          Private lessons with Jesús, on your own or with a small group. Every session is
          60 minutes. Book a single session, or a four-week block with one session a week.
        </p>
      </header>
      <div class="mt-14 grid gap-7 lg:grid-cols-3">
        <div class="reveal overflow-hidden rounded-2xl">
          <Image
            src={coachAction}
            alt="Jesús Maicas playing a smash on court at Banner Padel"
            widths={[480, 800]}
            sizes="(min-width: 1024px) 30vw, 92vw"
            class="h-64 w-full object-cover object-top lg:h-full"
            loading="lazy"
          />
        </div>
        {
          [
            { title: "Single sessions", sub: "Pay as you go · 60 minutes", rows: singleSessions },
            { title: "Four-week blocks", sub: "One session a week · 60 minutes", rows: blockSessions },
          ].map((panel) => (
            <div class="reveal rounded-2xl bg-white/5 p-8 ring-1 ring-white/15 md:p-9">
              <h3 class="font-display text-2xl font-bold tracking-tight">{panel.title}</h3>
              <p class="mt-1.5 text-sm text-bone/55">{panel.sub}</p>
              <ul class="mt-4 divide-y divide-white/10">
                {panel.rows.map((row) => (
                  <li class="flex items-baseline justify-between gap-4 py-3.5">
                    <span class="text-bone/85">{row.name}</span>
                    <span class="text-right font-display text-lg font-bold">
                      {row.price}
                      {row.each && (
                        <span class="block text-xs font-normal text-bone/50">{row.each}</span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="reveal mt-10">
        <Button href="/contact/" variant="light">Enquire about lessons</Button>
      </div>
    </div>
  </section>

  <Section tone="white" eyebrow="The pathway" title="Wherever you're starting from.">
    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        path.map((stage, i) => (
          <div class="reveal bg-white p-8">
            <p class="font-display text-sm font-bold tracking-widest text-saffron-600">
              0{i + 1}
            </p>
            <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">{stage.step}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{stage.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <section class="bg-bone px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="reveal overflow-hidden rounded-2xl">
        <Image
          src={court}
          alt="Indoor padel court at Banner Padel, Ennis"
          widths={[480, 720, 1024]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="h-[380px] w-full object-cover md:h-[520px]"
          loading="lazy"
        />
      </div>
      <div class="reveal">
        <p class="eyebrow mb-5 text-navy/45">Corporate & groups</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">
          Bring the whole team.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          Team days, birthdays, stags, hens, club nights and work socials. We can put
          coaches on multiple courts at once, run an Americano format so nobody sits out,
          and have the café ready afterwards. It works just as well for a group who have
          never held a racket as for one that plays weekly.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <Button href="/contact/">Enquire about a group</Button>
          <Button href={site.social.instagram} variant="outline" external>See it on Instagram</Button>
        </div>
      </div>
    </div>
  </section>

  <BookingCta
    title="Book your first lesson."
    body="Tell us your level and what you want out of it, and we'll put you with the right coach and the right group."
  />
</Layout>
